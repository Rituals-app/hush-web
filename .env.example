# Rituals Space web client (modified Hush web client) - local development environment
# Copy to .env.local and adjust. All variables are optional for hosted-default dev.

# Base URL of the hush-server API (default: same origin / hosted instance)
VITE_API_URL=

# LiveKit signaling URL override (default: derived from the instance handshake)
VITE_LIVEKIT_URL=

# Rituals fork: AGPL source links shown in the About dialog (public URLs only;
# default https://space.rit.al/source/ for each), plus the optional source commit.
VITE_RITUALS_SOURCE_WEB=
VITE_RITUALS_SOURCE_SERVER=
VITE_RITUALS_SOURCE_CRYPTO=
VITE_RITUALS_SOURCE_COMMIT=
